# Supabase credentials for the hub.
#
# Copy this file to `.env` and fill it in. `.env` is gitignored; this example is not.
#
# These are read by Vite and INLINED INTO THE BUNDLE AT BUILD TIME. They must be present
# when `npm run dev` or `npm run tauri build` starts, and they cannot be supplied at
# runtime afterwards. A build compiled without them shows a "Not configured" screen — it
# does not silently fall back to anything.
#
# The publishable key is meant to ship inside the client, so it is not a secret. If your
# project predates publishable keys, the legacy anon JWT key works too: set
# VITE_SUPABASE_ANON_KEY instead. Either variable name is accepted.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Live presence for Workspaces: the Cloudflare Durable Object deployed from
# `cloudflare/workspace-room`. It carries cursors and "who is online" between the
# people in a workspace.
#
# Optional — leave it empty and the code falls back to the deployed worker, so a
# release build cannot ship without cursors just because this variable was not
# passed to the build. Set it only to point at a *different* deployment, for
# example the URL `npm run dev` prints inside `cloudflare/workspace-room`. It must
# be an origin with no trailing slash, e.g.
#   VITE_WORKSPACE_LIVE_URL=https://apro-workspace-room.<account>.workers.dev
# Like the values above, this is inlined at build time and needs a restart to
# take effect.
VITE_WORKSPACE_LIVE_URL=
