{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APRO Works",
  "version": "0.2.1",
  "identifier": "com.apro.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "APRO Works",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#08090b",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
