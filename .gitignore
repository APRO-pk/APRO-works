# Dependencies
node_modules/

# Rust build output. The Cargo workspace is at the repo root, so `target/` sits
# beside the frontend. A bare pattern matches at every level (root, harness/,
# src-tauri/), which an anchored /target/ would not.
target/

# Environment variables / secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Local database / temp files
*.sqlite
*.sqlite3
*.db
tmp/
temp/

# Generated by `npm run verify:workflow`
.workflow-verify.mjs

# Supabase local dev files, if you use Supabase CLI
.supabase/